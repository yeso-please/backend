# Copy to .env and fill locally. Never commit .env or share secret values.
# dev-rds profile: jdbc:postgresql://<RDS_ENDPOINT>:5432/tripin_dev?currentSchema=app&sslmode=verify-full&sslrootcert=<local-ca-bundle-path>
DB_URL=
DB_USERNAME=
DB_PASSWORD=
KAKAO_REST_API_KEY=
# Kakao login app REST API key. Leave empty to reuse KAKAO_REST_API_KEY (same app).
KAKAO_LOGIN_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# Comma-separated, exact match with the Kakao console Redirect URIs (HTTPS outside local).
KAKAO_ALLOWED_REDIRECT_URIS=
TOUR_API_KEY=
TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2
INGESTION_ACTOR=
MIGRATION_TARGET_ENV=
MIGRATION_BEFORE_SNAPSHOT=
MIGRATION_CONFIRM_RUN_ID=
